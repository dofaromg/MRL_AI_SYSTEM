# ============================================================================
#  .env.mrl-baseworld.example
#  origin_signature: MrLiouWord
#  歸屬: MRL母體工程架構中心
#  分支: MRL_Branch_06_BaseWorld_DB_Deploy_DL580
#
#  使用方式: cp .env.mrl-baseworld.example .env.mrl-baseworld
#  然後修改 MRL_DB_PASSWORD 為你的實際密碼
# ============================================================================

# === 資料庫設定 ===
MRL_DB_NAME=mrl_baseworld
MRL_DB_USER=mrl_admin
MRL_DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
MRL_DB_PORT=5432

# === 系統識別 ===
MRL_ORIGIN_SIGNATURE=MrLiouWord
MRL_ENGINE_VERSION=2.1.0
MRL_ROLE=canonical_mother_db

# === 備份設定 ===
MRL_BACKUP_DIR=/backups
MRL_BACKUP_RETAIN_DAYS=30

# === 部署位置 ===
MRL_DEPLOY_TARGET=DL580
MRL_CANONICAL_LOCATION=local
# Cloudflare 僅作未來鏡像，不作主庫
MRL_CLOUDFLARE_ROLE=mirror_only
