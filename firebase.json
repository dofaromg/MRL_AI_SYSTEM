{
  "hosting": {
    "public": "deploy/firebase_hosting/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-MRL-Origin-Signature", "value": "MrLiouWord" }
        ]
      }
    ]
  }
}
