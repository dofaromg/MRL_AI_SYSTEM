# MRL_AI_SYSTEM Production Configuration

# ==========================================
# Production Deployment Configuration
# Origin Signature: MrLiouWord
# ==========================================

# ── Runtime Control ───────────────────────
# CRITICAL: Set to 'production' to prohibit MockAdapter
# Options: production | development | test
MRL_RUNTIME_MODE=production

# Runtime origin identifier (for DL580 deployment)
MRL_LOCAL_RUNTIME=DL580_localhost

# ── LLM Configuration ─────────────────────
# Default model for production
# MUST be a real model, not 'mock'
MRL_LLM_DEFAULT_MODEL=gpt-4o

# Local model endpoint (DL580)
MRL_LLM_LOCAL_BASE_URL=http://localhost:11434/v1

# Cloud API keys (if using OpenAI/Anthropic)
# MRL_LLM_OPENAI_API_KEY=sk-...
# MRL_LLM_ANTHROPIC_API_KEY=sk-ant-...

# LLM generation settings
MRL_LLM_MAX_TOKENS=2048
MRL_LLM_TEMPERATURE=0.7

# ── API Gateway ───────────────────────────
# API server binding
MRL_API_HOST=0.0.0.0
MRL_API_PORT=7771

# Authentication (set to true for production)
MRL_API_REQUIRE_AUTH=true
MRL_API_AUTH_TOKEN=your-secure-token-here-change-this

# CORS origins (comma-separated)
# Use specific domains in production, not '*'
MRL_API_CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com

# ── Memory & Storage ──────────────────────
# Merkle chain storage
MRL_MEMORY_MERKLE_CHAIN_PATH=03_memory/_data/memory_chain

# Vector store path
MRL_MEMORY_VECTOR_STORE_PATH=03_memory/vector/_data

# Max vector entries
MRL_MEMORY_MAX_VECTOR_ENTRIES=10000

# ── Context Management ────────────────────
# Context window settings
MRL_CONTEXT_MAX_TOKENS=4096
MRL_CONTEXT_REPLY_RESERVE=512
MRL_CONTEXT_STRATEGY=truncate_oldest

# ── Conversation Management ───────────────
# Session storage
MRL_CONVERSATION_STORE_PATH=data/conversations.json

# Max concurrent sessions
MRL_CONVERSATION_MAX_SESSIONS=1000

# Default system prompt
MRL_CONVERSATION_DEFAULT_SYSTEM_PROMPT="You are MRL_AGI, a production-grade private AI assistant. Origin signature: MrLiouWord. Always act in accordance with the Mother Core Assembly laws."

# ── Task Scheduler ────────────────────────
# Background task workers
MRL_SCHEDULER_WORKERS=4

# Max queue size
MRL_SCHEDULER_MAX_QUEUE=1000

# ── System Settings ───────────────────────
# System identification
MRL_SYSTEM_NAME=MRL_AGI
MRL_SYSTEM_VERSION=2.0
MRL_SYSTEM_ORIGIN_SIGNATURE=MrLiouWord

# Debug mode (disable in production)
MRL_SYSTEM_DEBUG=false

# Log level: DEBUG | INFO | WARNING | ERROR
MRL_SYSTEM_LOG_LEVEL=INFO

# ── Result Gating ─────────────────────────
# Result storage paths
MRL_RESULT_STORE_PATH=data/gated_results.json
MRL_ENTITLEMENT_STORE_PATH=data/entitlements.json
MRL_ACCESS_LOG_PATH=data/access_log.jsonl

# ── Security ──────────────────────────────
# Rate limiting (requests per minute per IP)
# MRL_RATE_LIMIT_RPM=100

# Request size limit (MB)
# MRL_REQUEST_SIZE_LIMIT=10

# ==========================================
# Usage:
#   1. Copy this file to .env
#   2. Update all placeholders (your-*, change-this)
#   3. Source the file: source .env
#   4. Start services: python 09_workflow/api_gateway.py
# ==========================================